{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhasaForge",
  "version": "0.3.3",
  "identifier": "net.dia.phasaforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PhasaForge",
        "width": 640,
        "height": 480,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "A local Thai learning companion",
    "longDescription": "A compact desktop tool for exploring Thai text, speech and practice.",
    "copyright": "© 2026 Warren Gerdes",
    "publisher": "Warren Gerdes",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
